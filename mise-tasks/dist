#!/usr/bin/env bash
#MISE description="Release assets into dist/: archives for Linux (static musl) and macOS, x86_64 and aarch64, .deb and .rpm packages, and the source tarball"
set -euo pipefail

version="$(sed -n 's/^    \.version = "\([^"]*\)",$/\1/p' build.zig.zon)"
targets=(x86_64-linux-musl aarch64-linux-musl x86_64-macos aarch64-macos)

if [[ -n "$(git status --porcelain)" ]]; then
  echo "warning: uncommitted changes are in the binaries but not in the source tarball, which is cut from HEAD" >&2
fi
rm -rf dist
mkdir -p dist/share/completions
zig build -Doptimize=ReleaseSafe --prefix dist/build/host
smith=dist/build/host/bin/smith
"${smith}" completion bash >dist/share/completions/smith.bash
"${smith}" completion zsh >dist/share/completions/_smith
"${smith}" completion fish >dist/share/completions/smith.fish
"${smith}" help man >dist/share/smith.1
gzip -9nc dist/share/smith.1 >dist/share/smith.1.gz
package="$(sed -n 's/^name: //p' packaging/nfpm.yaml)"
maintainer="$(sed -n 's/^maintainer: //p' packaging/nfpm.yaml)"
awk -v format=chglog -v packager="${maintainer}" -f packaging/changelog.awk CHANGELOG.md >dist/share/changelog.yaml
awk -v format=deb -v name="${package}" -v packager="${maintainer}" -f packaging/changelog.awk CHANGELOG.md | gzip -9n >dist/share/changelog.gz
cp packaging/nfpm.yaml dist/share/nfpm-deb.yaml
{ cat packaging/nfpm.yaml; echo "changelog: changelog.yaml"; } >dist/share/nfpm-rpm.yaml

for target in "${targets[@]}"; do
  prefix="dist/build/${target}"
  zig build -Doptimize=ReleaseSafe -Dtarget="${target}" --prefix "${prefix}"
  name="smith-${version}-${target}"
  mkdir -p "dist/${name}"
  cp "${prefix}/bin/smith" dist/share/smith.1 README.md LICENSE CHANGELOG.md "dist/${name}/"
  tar -C dist -czf "dist/${name}.tar.gz" "${name}"
  rm -rf "dist/${name}"
  case "${target}" in
    x86_64-linux-musl) arch=amd64 ;;
    aarch64-linux-musl) arch=arm64 ;;
    *) continue ;;
  esac
  stage="dist/build/package-${arch}"
  mkdir -p "${stage}"
  cp -r "${prefix}/bin/smith" dist/share/. README.md LICENSE CHANGELOG.md packaging/lintian-overrides "${stage}/"
  for packager in deb rpm; do
    (cd "${stage}" && VERSION="${version}" ARCH="${arch}" nfpm package --config "nfpm-${packager}.yaml" --packager "${packager}" --target ../..)
  done
done
git archive --format=tar.gz --prefix="smith-${version}/" -o "dist/smith-${version}.tar.gz" HEAD
rm -rf dist/build dist/share
if command -v sha256sum >/dev/null; then
  (cd dist && sha256sum -- *.tar.gz *.deb *.rpm >SHA256SUMS)
else
  (cd dist && shasum -a 256 -- *.tar.gz *.deb *.rpm >SHA256SUMS)
fi
ls -l dist
